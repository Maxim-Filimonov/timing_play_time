<Layouts.app flash={@flash}>
  <div id="timezone-detector" phx-hook=".TimezoneDetector"></div>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".TimezoneDetector">
    export default {
      mounted() {
        this.pushEvent("detected_timezone", {
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone
        })
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".DebugTrigger">
    export default {
      // Triple-click within 600ms reveals the debug overlay — a deliberate
      // gesture, not a click a normal user makes by accident.
      mounted() {
        this.clickTimes = []
        this.el.addEventListener("click", () => {
          const now = Date.now()
          this.clickTimes = [...this.clickTimes, now].filter(t => now - t < 600)
          if (this.clickTimes.length >= 3) {
            this.clickTimes = []
            this.pushEvent("reveal_debug", {})
          }
        })
      }
    }
  </script>

  <div class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 px-4 py-8">
    <div class="mx-auto max-w-4xl space-y-8">
      <div class="flex justify-end">
        <a href={~p"/settings"} class="text-purple-700 hover:text-purple-900 text-sm font-semibold">
          ⚙️ Settings
        </a>
      </div>

      <%= if @show_arrival_banner do %>
        <div class="flex items-center justify-between gap-4 rounded-2xl bg-indigo-50 border-2 border-indigo-200 px-5 py-4">
          <p class="text-indigo-900 text-sm">
            New here — or picking up on a new device? Continue with an email to link this
            Playtime or bring back one you started elsewhere.
          </p>
          <div class="flex gap-3 shrink-0">
            <a href={~p"/auth/continue"} class="text-indigo-700 hover:text-indigo-900 text-sm font-semibold underline">
              Continue with email
            </a>
            <button
              type="button"
              phx-click="dismiss_arrival_banner"
              class="text-indigo-400 hover:text-indigo-600 text-sm font-semibold"
            >
              I'm new — hide this
            </button>
          </div>
        </div>
      <% end %>

      <%!-- Playtime Hero Section (day-scoped; the all-time cumulative Play
      Balance lives in the debug overlay below, per the redesign — see
      CONTEXT.md's Play Balance entry for why it isn't shown here) --%>
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-800 p-8 text-white shadow-2xl">
        <div class="relative z-10">
          <h1 class="text-4xl font-bold mb-2">Playtime</h1>
          <p class="text-purple-200 mb-6">Time you've earned to spend on fun today!</p>

          <%= if @today do %>
            <div class="flex items-baseline gap-3 mb-2">
              <.time_display
                minutes={@today.playtime}
                value_class={"text-7xl font-black #{if @today.playtime < 0, do: "text-red-300"}"}
                unit_class="text-3xl font-semibold text-purple-200"
              />
            </div>

            <%!-- Playtime == week_earned - week_drained - week_used +
            pushscroll_balance, for almost every spend logged after ADR-0012
            (see PlayBalance.Today's moduledoc for the one known gap) —
            shown so the hero number is checkable at a glance, rather than
            requiring an explanation of how Today's PT/Reserve are
            split. Drained is 0 for a User with no Draining Activities
            (ADR-0013). --%>
            <p class="text-purple-200 text-sm mb-6">
              = <.time_display
                minutes={@today.week_earned}
                format={:short}
                value_class="font-semibold text-white"
              /> earned this week − <.time_display
                minutes={@today.week_drained}
                format={:short}
                value_class="font-semibold text-white"
              /> drained this week − <.time_display
                minutes={@today.week_used}
                format={:short}
                value_class="font-semibold text-white"
              /> used this week + <.time_display
                minutes={@today.pushscroll_balance}
                format={:short}
                value_class="font-semibold text-white"
              /> Pushscroll Balance
            </p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">Today's</div>
                <div class="flex justify-between">
                  <span>Earned Today</span>
                  <span class="font-bold">{Float.round(@today.earned_today, 1)}</span>
                </div>
                <div class="flex justify-between">
                  <span>Drained Today</span>
                  <span class="font-bold text-red-300">{Float.round(@today.drained_today, 1)}</span>
                </div>
                <div class="flex justify-between">
                  <span>Used Today</span>
                  <span class="font-bold text-amber-300">{Float.round(@today.used_today, 1)}</span>
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">This Week</div>
                <div class="flex justify-between">
                  <span>Earned</span>
                  <span class="font-bold">{Float.round(@today.week_earned, 1)}</span>
                </div>
                <div class="flex justify-between">
                  <span>Drained</span>
                  <span class="font-bold text-red-300">{Float.round(@today.week_drained, 1)}</span>
                </div>
                <div class="flex justify-between">
                  <span>Used</span>
                  <span class="font-bold text-amber-300">{Float.round(@today.week_used, 1)}</span>
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">Reserve</div>
                <div class={"text-2xl font-bold #{if @today.reserve < 0, do: "text-red-300"}"}>
                  {Float.round(@today.reserve, 1)}
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">Pushscroll Balance</div>
                <div class="text-2xl font-bold">{Float.round(@today.pushscroll_balance, 1)}</div>
              </div>
            </div>
          <% else %>
            <div class="animate-pulse">
              <div class="flex items-baseline gap-3 mb-6">
                <span class="text-7xl font-black text-white/40">···</span>
                <span class="text-3xl font-semibold text-purple-200">minutes</span>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
              </div>
            </div>
          <% end %>
        </div>

        <%!-- Decorative Elements --%>
        <div class="absolute -top-20 -right-20 size-64 bg-purple-500/30 rounded-full blur-3xl">
        </div>
        <div class="absolute -bottom-20 -left-20 size-64 bg-indigo-500/30 rounded-full blur-3xl">
        </div>
      </div>

      <%!-- Debug overlay: the all-time cumulative Play Balance breakdown,
      revealed by triple-clicking the 🎮 icon on the Log Playtime card
      below. Not persisted — resets to hidden on every mount. --%>
      <%= if @show_debug do %>
        <div
          id="debug-overlay"
          class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4"
          phx-click-away="hide_debug"
        >
          <div class="relative w-full max-w-2xl rounded-3xl bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-800 p-8 text-white shadow-2xl">
            <button
              type="button"
              phx-click="hide_debug"
              aria-label="Close"
              class="absolute top-4 right-4 text-2xl font-bold text-white/80 hover:text-white"
            >
              &times;
            </button>

            <h1 class="text-4xl font-bold mb-2">Your Play Balance</h1>
            <p class="text-purple-200 mb-6">Time you've earned to spend on fun!</p>

            <div class="flex items-baseline gap-3 mb-6">
              <.time_display
                minutes={@balance.total}
                value_class="text-7xl font-black"
                unit_class="text-3xl font-semibold text-purple-200"
              />
            </div>

            <div class="relative h-6 bg-purple-900/40 rounded-full overflow-hidden mb-8 backdrop-blur-sm">
              <div
                class={"absolute inset-y-0 left-0 rounded-full transition-all duration-1000 ease-out #{balance_gradient(@balance)}"}
                style={"width: #{balance_percentage(@balance)}%"}
              >
                <div class="absolute inset-0 bg-white/20 animate-pulse"></div>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-4 text-sm">
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-1">Earned (Timing)</div>
                <div class="text-2xl font-bold">
                  {Float.round(@balance.timing_derived_total, 1)}
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-1">Pushscroll Balance</div>
                <div class="text-2xl font-bold">{Float.round(@balance.manual_sync_total, 1)}</div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-1">Used</div>
                <div class="text-2xl font-bold text-red-300">
                  {Float.round(@balance.playtime_used_total, 1)}
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%!-- Quick Actions --%>
      <div class="grid md:grid-cols-2 gap-6">
        <%!-- Log Playtime Used --%>
        <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-orange-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">
            <span id="debug-trigger" phx-hook=".DebugTrigger" class="cursor-pointer select-none">
              🎮
            </span>
            Log Playtime
          </h2>
          <p class="text-gray-600 mb-4 text-sm">
            Used some playtime gaming or relaxing? Log it here!
          </p>

          <form phx-submit="log_playtime" class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Minutes Used</label>
              <input
                type="number"
                name="minutes"
                step="0.1"
                min="0"
                placeholder="30.0"
                class="w-full px-4 py-3 rounded-xl border-2 border-orange-300 focus:border-orange-500 focus:ring focus:ring-orange-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-orange-50"
                required
              />
            </div>
            <%!-- phx-disable-with blocks the double-submit that would
            otherwise draw the same entries down twice: a spend is a
            read-modify-write over the Entry Consumption Ledger (ADR-0012),
            so two in-flight spends both see the same pre-spend remaining. --%>
            <button
              type="submit"
              phx-disable-with="Logging..."
              class="w-full bg-gradient-to-r from-orange-500 to-red-500 text-white font-bold py-3 px-6 rounded-xl hover:from-orange-600 hover:to-red-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Log Playtime
            </button>
          </form>
        </div>

        <%!-- Pushscroll Balance --%>
        <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-green-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">🏃 Pushscroll Balance</h2>
          <p class="text-gray-600 mb-4 text-sm">
            Rises when you exercise, falls when you use tracked apps.
          </p>

          <form phx-submit="set_manual_sync" class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Total Minutes</label>
              <input
                type="number"
                name="minutes"
                step="0.1"
                min="0"
                placeholder="150.0"
                value={@balance && @balance.manual_sync_total}
                class="w-full px-4 py-3 rounded-xl border-2 border-green-300 focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-green-50"
                required
              />
            </div>
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-green-500 to-emerald-500 text-white font-bold py-3 px-6 rounded-xl hover:from-green-600 hover:to-emerald-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
              Update Pushscroll Balance
            </button>
          </form>
        </div>
      </div>

      <%!-- Sign-crossing confirmation: shown when a save would make an
      Activity *become* draining (ADR-0013). The write is stashed in
      @pending_activity until the user confirms; Cancel discards it. --%>
      <%= if @pending_activity do %>
        <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-red-300">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">
            Make “{@pending_activity.attrs.name}” a Draining Activity?
          </h2>
          <p class="text-gray-700 mb-4">
            <%= if @pending_activity.projected_play_minutes == 0.0 do %>
              No tracked time in the last 7 days, so nothing is deducted right now.
            <% else %>
              This will subtract <.time_display
                minutes={abs(@pending_activity.projected_play_minutes)}
                format={:short}
                value_class="font-bold text-red-600"
              /> of play time already earned this week.
            <% end %>
          </p>
          <div class="flex gap-2">
            <button
              type="button"
              phx-click="confirm_pending_activity"
              class="px-4 py-2 bg-red-600 text-white rounded-lg font-bold text-sm hover:bg-red-700"
            >
              Confirm
            </button>
            <button
              type="button"
              phx-click="cancel_pending_activity"
              class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg font-bold text-sm hover:bg-gray-50"
            >
              Cancel
            </button>
          </div>
        </div>
      <% end %>

      <%!-- Configure Activities --%>
      <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-pink-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">⚙️ Add an Activity</h2>

        <form phx-submit="create_activity" class="grid md:grid-cols-5 gap-4 items-end">
          <div class="md:col-span-1">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Name</label>
            <input
              type="text"
              name="name"
              placeholder="Coding"
              class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-pink-50"
              required
            />
          </div>
          <div class="md:col-span-1">
            <.live_component
              module={SourcePickerComponent}
              id="source-picker-new"
              source_list={@source_list}
            />
          </div>
          <div class="md:col-span-1">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Multiplier</label>
            <input
              type="number"
              name="multiplier"
              step="0.1"
              placeholder="1.0"
              class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-pink-50"
              required
            />
          </div>
          <div class="md:col-span-1">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Effect</label>
            <.effect_switcher selected={:positive} />
          </div>
          <div class="md:col-span-1">
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-pink-500 to-purple-500 text-white font-bold py-3 px-6 rounded-xl hover:from-pink-600 hover:to-purple-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
              Add Activity
            </button>
          </div>
        </form>
      </div>

      <%!-- Weekly distribution chart (#16). Render ladder (#12): the whole
      card is absent when the window holds no tracked minutes (rung 1); a
      plain upward column chart when no Draining Activity is configured
      (rung 2); a diverging chart around a zero baseline — earn up, drain
      down, same px-per-minute scale — once one exists (rung 3). --%>
      <div
        :if={@week_distribution.any_data}
        class="bg-white rounded-2xl p-6 shadow-lg border-2 border-purple-200"
      >
        <h2 class="text-2xl font-bold text-gray-900 mb-6">📊 This week by day</h2>
        <% ceiling = @week_distribution.chart_ceiling %>

        <div
          data-role="effect-legend"
          class="flex flex-wrap gap-x-4 gap-y-2 mb-6 text-sm text-gray-600"
        >
          <div
            :for={activity <- legend_activities(@activities, @week_distribution)}
            class="flex items-center gap-2"
          >
            <span class={"inline-block size-3 rounded-sm #{EffectColors.segment_class(activity.effect, activity_band(activity))}"}>
            </span>
            <span>{activity.name}</span>
            <span class="font-semibold text-gray-500">{signed_multiplier(activity)}</span>
          </div>
        </div>

        <%= if @week_distribution.has_drains do %>
          <div data-chart="diverging" class="flex items-stretch gap-2">
            <div
              class="flex flex-col justify-between text-xs text-gray-400 pr-1 text-right"
              style="width: 2.5rem"
            >
              <span>earn</span>
              <span>0</span>
              <span>drain</span>
            </div>
            <div class="flex-1 flex items-stretch gap-1">
              <div
                :for={day <- @week_distribution.days}
                class="flex-1 flex flex-col items-center"
              >
                <div
                  class="relative w-full flex flex-col justify-end"
                  style={"height: #{chart_arm_px()}px"}
                >
                  <span
                    :if={arm_clamped?(day.earn_total, ceiling)}
                    class="absolute inset-x-0 top-0 text-center text-[10px] font-semibold leading-none text-gray-600"
                  >
                    <.time_display minutes={day.earn_total} format={:short} />
                  </span>
                  <div
                    class={[
                      "w-full flex flex-col-reverse rounded-t overflow-hidden",
                      arm_clamped?(day.earn_total, ceiling) && "chart-bar--clamped-up"
                    ]}
                    style={"height: #{arm_px(day.earn_total, ceiling)}px"}
                  >
                    <div
                      :for={segment <- day.earn}
                      class={EffectColors.segment_class(:positive, segment.band)}
                      style={"flex: #{segment.play_minutes}"}
                      title={"#{segment.name}: #{Float.round(segment.play_minutes, 1)}"}
                    >
                    </div>
                  </div>
                </div>
                <div class="w-full border-t border-gray-300"></div>
                <div class="relative w-full">
                  <span
                    :if={arm_clamped?(day.drain_total, ceiling)}
                    class="absolute inset-x-0 bottom-0 text-center text-[10px] font-semibold leading-none text-gray-600"
                  >
                    <.time_display minutes={day.drain_total} format={:short} />
                  </span>
                  <div
                    class={[
                      "w-full flex flex-col rounded-b overflow-hidden",
                      arm_clamped?(day.drain_total, ceiling) && "chart-bar--clamped-down"
                    ]}
                    style={"height: #{arm_px(day.drain_total, ceiling)}px"}
                  >
                    <div
                      :for={segment <- day.drain}
                      class={EffectColors.segment_class(:negative, segment.band)}
                      style={"flex: #{segment.play_minutes}"}
                      title={"#{segment.name}: #{Float.round(segment.play_minutes, 1)}"}
                    >
                    </div>
                  </div>
                </div>
                <span class="mt-1 text-xs text-gray-500">{day_label(day.date)}</span>
              </div>
            </div>
          </div>
        <% else %>
          <div data-chart="upward" class="flex items-end gap-1" style={"height: #{chart_track_px()}px"}>
            <div
              :for={day <- @week_distribution.days}
              class="flex-1 flex flex-col items-center justify-end h-full"
            >
              <span
                :if={arm_clamped?(day.earn_total, ceiling)}
                class="text-[10px] font-semibold leading-none text-gray-600 mb-0.5"
              >
                <.time_display minutes={day.earn_total} format={:short} />
              </span>
              <div
                class={[
                  "w-full flex flex-col-reverse rounded-t overflow-hidden",
                  arm_clamped?(day.earn_total, ceiling) && "chart-bar--clamped-up"
                ]}
                style={"height: #{arm_px(day.earn_total, ceiling)}px"}
              >
                <div
                  :for={segment <- day.earn}
                  class={EffectColors.segment_class(:positive, segment.band)}
                  style={"flex: #{segment.play_minutes}"}
                  title={"#{segment.name}: #{Float.round(segment.play_minutes, 1)}"}
                >
                </div>
              </div>
              <span class="mt-1 text-xs text-gray-500">{day_label(day.date)}</span>
            </div>
          </div>
        <% end %>
      </div>

      <%!-- Activities List --%>
      <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-purple-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">🎯 Your Activities</h2>

        <%= if @activities == nil do %>
          <div class="space-y-4 animate-pulse">
            <div class="h-24 rounded-xl bg-purple-50 border border-purple-200"></div>
            <div class="h-24 rounded-xl bg-purple-50 border border-purple-200"></div>
          </div>
        <% end %>
        <%= if @activities == [] do %>
          <div class="text-center py-12 text-gray-500">
            <div class="text-6xl mb-4">🌟</div>
            <p class="text-lg">No activities yet!</p>
            <p class="text-sm mt-2">Activities will earn you play minutes based on time spent.</p>
          </div>
        <% end %>
        <%= if @activities not in [nil, []] do %>
          <div class="space-y-4">
            <%= for activity <- @activities do %>
              <%= if @editing_activity_id == activity.id do %>
                <form
                  phx-submit="save_activity"
                  class="p-4 rounded-xl bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-200"
                >
                  <input type="hidden" name="activity_id" value={activity.id} />
                  <div class="grid md:grid-cols-4 gap-4 items-end">
                    <div class="md:col-span-1">
                      <label class="block text-sm font-semibold text-gray-700 mb-2">Name</label>
                      <input
                        type="text"
                        name="name"
                        value={activity.name}
                        class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 bg-pink-50"
                        required
                      />
                    </div>
                    <div class="md:col-span-1">
                      <.live_component
                        module={SourcePickerComponent}
                        id={"source-picker-#{activity.id}"}
                        source_list={@source_list}
                        current_id={activity.time_source_identifier}
                        current_label={activity.time_source_label}
                      />
                    </div>
                    <div class="md:col-span-1">
                      <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Multiplier
                      </label>
                      <div class="flex items-center gap-2">
                        <button
                          type="button"
                          phx-click="decrement_multiplier"
                          class="px-3 py-3 rounded-xl border-2 border-pink-300 text-pink-700 font-bold hover:bg-pink-100"
                        >
                          −
                        </button>
                        <input
                          type="text"
                          name="multiplier"
                          value={@editing_multiplier}
                          readonly
                          class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 text-gray-900 bg-pink-50 text-center"
                        />
                        <button
                          type="button"
                          phx-click="increment_multiplier"
                          class="px-3 py-3 rounded-xl border-2 border-pink-300 text-pink-700 font-bold hover:bg-pink-100"
                        >
                          +
                        </button>
                      </div>
                    </div>
                    <div class="md:col-span-1">
                      <label class="block text-sm font-semibold text-gray-700 mb-2">Effect</label>
                      <.effect_switcher selected={activity.effect} />
                    </div>
                  </div>
                  <div class="flex justify-end gap-2 mt-4">
                    <button
                      type="button"
                      phx-click="cancel_edit_activity"
                      class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg font-bold text-sm hover:bg-gray-50"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="px-4 py-2 bg-purple-600 text-white rounded-lg font-bold text-sm hover:bg-purple-700"
                    >
                      Save
                    </button>
                  </div>
                </form>
              <% else %>
                <div class={"flex items-center gap-4 p-4 rounded-xl bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-200 border-l-4 #{EffectColors.rail_class(activity.effect, activity_band(activity))}"}>
                  <div class="flex-1">
                    <div class="font-bold text-gray-900 text-lg">{activity.name}</div>
                    <div class="text-sm text-gray-600">
                      <span class={"inline-block rounded px-2 py-0.5 text-white font-semibold #{EffectColors.chip_class(activity.effect, activity_band(activity))}"}>
                        {signed_multiplier(activity)}
                      </span>
                      · Source:
                      <%= if activity.time_source_label do %>
                        <span class="text-xs text-gray-500">{activity.time_source_label}</span>
                      <% else %>
                        <span class="font-mono text-xs text-gray-500">
                          {activity.time_source_identifier}
                        </span>
                      <% end %>
                    </div>
                    <div class="text-sm text-gray-600 mt-1">
                      Today: <.time_display
                        minutes={activity.minutes}
                        format={:short}
                        value_class="font-semibold text-gray-900"
                      />
                      · play {play_prefix(activity)}<.time_display
                        minutes={abs(activity.play_minutes)}
                        format={:short}
                        value_class={play_value_class(activity)}
                      />
                    </div>
                    <div class="text-sm text-gray-600 mt-1">
                      This week: <.time_display
                        minutes={activity.week_minutes}
                        format={:short}
                        value_class="font-semibold text-gray-900"
                      />
                      · play {play_prefix(activity)}<.time_display
                        minutes={abs(activity.week_play_minutes)}
                        format={:short}
                        value_class={play_value_class(activity)}
                      />
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      phx-click="edit_activity"
                      phx-value-id={activity.id}
                      class="px-4 py-2 bg-white border-2 border-purple-300 text-purple-700 rounded-lg font-bold text-sm hover:bg-purple-50"
                    >
                      Edit
                    </button>
                    <div class="px-4 py-2 bg-purple-600 text-white rounded-lg font-bold text-sm">
                      Active
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
