<Layouts.app flash={@flash}>
  <div id="timezone-detector" phx-hook=".TimezoneDetector"></div>
  <script :type={Phoenix.LiveView.ColocatedHook} name=".TimezoneDetector">
    export default {
      mounted() {
        this.pushEvent("detected_timezone", {
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone
        })
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".DebugTrigger">
    export default {
      // Triple-click within 600ms reveals the debug overlay — a deliberate
      // gesture, not a click a normal user makes by accident.
      mounted() {
        this.clickTimes = []
        this.el.addEventListener("click", () => {
          const now = Date.now()
          this.clickTimes = [...this.clickTimes, now].filter(t => now - t < 600)
          if (this.clickTimes.length >= 3) {
            this.clickTimes = []
            this.pushEvent("reveal_debug", {})
          }
        })
      }
    }
  </script>

  <div class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 px-4 py-8">
    <div class="mx-auto max-w-4xl space-y-8">
      <div class="flex justify-end">
        <a href={~p"/settings"} class="text-purple-700 hover:text-purple-900 text-sm font-semibold">
          ⚙️ Settings
        </a>
      </div>

      <%!-- Playtime Hero Section (day-scoped; the all-time cumulative Play
      Balance lives in the debug overlay below, per the redesign — see
      CONTEXT.md's Play Balance entry for why it isn't shown here) --%>
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-800 p-8 text-white shadow-2xl">
        <div class="relative z-10">
          <h1 class="text-4xl font-bold mb-2">Playtime</h1>
          <p class="text-purple-200 mb-6">Time you've earned to spend on fun today!</p>

          <%= if @today do %>
            <div class="flex items-baseline gap-3 mb-2">
              <.time_display
                minutes={@today.playtime}
                value_class={"text-7xl font-black #{if @today.playtime < 0, do: "text-red-300"}"}
                unit_class="text-3xl font-semibold text-purple-200"
              />
            </div>

            <%!-- Playtime == week_earned - week_used + pushscroll_balance, exactly,
            always (see PlayBalance.compute_today/4's moduledoc) — shown so the
            hero number is checkable at a glance, rather than requiring an
            explanation of how Today's PT/Reserve are split. --%>
            <p class="text-purple-200 text-sm mb-6">
              = <.time_display
                minutes={@today.week_earned}
                format={:short}
                value_class="font-semibold text-white"
              /> earned this week − <.time_display
                minutes={@today.week_used}
                format={:short}
                value_class="font-semibold text-white"
              /> used this week + <.time_display
                minutes={@today.pushscroll_balance}
                format={:short}
                value_class="font-semibold text-white"
              /> Pushscroll Balance
            </p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">Today's</div>
                <div class="flex justify-between">
                  <span>Earned Today</span>
                  <span class="font-bold">{Float.round(@today.earned_today, 1)}</span>
                </div>
                <div class="flex justify-between">
                  <span>Used Today</span>
                  <span class="font-bold text-red-300">{Float.round(@today.used_today, 1)}</span>
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">This Week</div>
                <div class="flex justify-between">
                  <span>Earned</span>
                  <span class="font-bold">{Float.round(@today.week_earned, 1)}</span>
                </div>
                <div class="flex justify-between">
                  <span>Used</span>
                  <span class="font-bold text-red-300">{Float.round(@today.week_used, 1)}</span>
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">Reserve</div>
                <div class={"text-2xl font-bold #{if @today.reserve < 0, do: "text-red-300"}"}>
                  {Float.round(@today.reserve, 1)}
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-2 font-semibold">Pushscroll Balance</div>
                <div class="text-2xl font-bold">{Float.round(@today.pushscroll_balance, 1)}</div>
              </div>
            </div>
          <% else %>
            <div class="animate-pulse">
              <div class="flex items-baseline gap-3 mb-6">
                <span class="text-7xl font-black text-white/40">···</span>
                <span class="text-3xl font-semibold text-purple-200">minutes</span>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
                <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm h-[68px]"></div>
              </div>
            </div>
          <% end %>
        </div>

        <%!-- Decorative Elements --%>
        <div class="absolute -top-20 -right-20 size-64 bg-purple-500/30 rounded-full blur-3xl">
        </div>
        <div class="absolute -bottom-20 -left-20 size-64 bg-indigo-500/30 rounded-full blur-3xl">
        </div>
      </div>

      <%!-- Debug overlay: the all-time cumulative Play Balance breakdown,
      revealed by triple-clicking the 🎮 icon on the Log Playtime card
      below. Not persisted — resets to hidden on every mount. --%>
      <%= if @show_debug do %>
        <div
          id="debug-overlay"
          class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4"
          phx-click-away="hide_debug"
        >
          <div class="relative w-full max-w-2xl rounded-3xl bg-gradient-to-br from-purple-600 via-purple-700 to-indigo-800 p-8 text-white shadow-2xl">
            <button
              type="button"
              phx-click="hide_debug"
              aria-label="Close"
              class="absolute top-4 right-4 text-2xl font-bold text-white/80 hover:text-white"
            >
              &times;
            </button>

            <h1 class="text-4xl font-bold mb-2">Your Play Balance</h1>
            <p class="text-purple-200 mb-6">Time you've earned to spend on fun!</p>

            <div class="flex items-baseline gap-3 mb-6">
              <.time_display
                minutes={@balance.total}
                value_class="text-7xl font-black"
                unit_class="text-3xl font-semibold text-purple-200"
              />
            </div>

            <div class="relative h-6 bg-purple-900/40 rounded-full overflow-hidden mb-8 backdrop-blur-sm">
              <div
                class={"absolute inset-y-0 left-0 rounded-full transition-all duration-1000 ease-out #{balance_gradient(@balance)}"}
                style={"width: #{balance_percentage(@balance)}%"}
              >
                <div class="absolute inset-0 bg-white/20 animate-pulse"></div>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-4 text-sm">
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-1">Earned (Timing)</div>
                <div class="text-2xl font-bold">
                  {Float.round(@balance.timing_derived_total, 1)}
                </div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-1">Pushscroll Balance</div>
                <div class="text-2xl font-bold">{Float.round(@balance.manual_sync_total, 1)}</div>
              </div>
              <div class="bg-white/10 rounded-xl p-4 backdrop-blur-sm">
                <div class="text-purple-200 mb-1">Used</div>
                <div class="text-2xl font-bold text-red-300">
                  {Float.round(@balance.playtime_used_total, 1)}
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <%!-- Quick Actions --%>
      <div class="grid md:grid-cols-2 gap-6">
        <%!-- Log Playtime Used --%>
        <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-orange-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">
            <span id="debug-trigger" phx-hook=".DebugTrigger" class="cursor-pointer select-none">
              🎮
            </span>
            Log Playtime
          </h2>
          <p class="text-gray-600 mb-4 text-sm">
            Used some playtime gaming or relaxing? Log it here!
          </p>

          <form phx-submit="log_playtime" class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Minutes Used</label>
              <input
                type="number"
                name="minutes"
                step="0.1"
                min="0"
                placeholder="30.0"
                class="w-full px-4 py-3 rounded-xl border-2 border-orange-300 focus:border-orange-500 focus:ring focus:ring-orange-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-orange-50"
                required
              />
            </div>
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-orange-500 to-red-500 text-white font-bold py-3 px-6 rounded-xl hover:from-orange-600 hover:to-red-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
              Log Playtime
            </button>
          </form>
        </div>

        <%!-- Pushscroll Balance --%>
        <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-green-200">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">🏃 Pushscroll Balance</h2>
          <p class="text-gray-600 mb-4 text-sm">
            Rises when you exercise, falls when you use tracked apps.
          </p>

          <form phx-submit="set_manual_sync" class="space-y-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Total Minutes</label>
              <input
                type="number"
                name="minutes"
                step="0.1"
                min="0"
                placeholder="150.0"
                value={@balance && @balance.manual_sync_total}
                class="w-full px-4 py-3 rounded-xl border-2 border-green-300 focus:border-green-500 focus:ring focus:ring-green-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-green-50"
                required
              />
            </div>
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-green-500 to-emerald-500 text-white font-bold py-3 px-6 rounded-xl hover:from-green-600 hover:to-emerald-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
              Update Pushscroll Balance
            </button>
          </form>
        </div>
      </div>

      <%!-- Configure Activities --%>
      <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-pink-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">⚙️ Add an Activity</h2>

        <form phx-submit="create_activity" class="grid md:grid-cols-4 gap-4 items-end">
          <div class="md:col-span-1">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Name</label>
            <input
              type="text"
              name="name"
              placeholder="Coding"
              class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-pink-50"
              required
            />
          </div>
          <div class="md:col-span-1">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Timing Project</label>
            <input
              type="text"
              name="time_source_identifier"
              placeholder="coding-project"
              class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-pink-50"
              required
            />
          </div>
          <div class="md:col-span-1">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Multiplier</label>
            <input
              type="number"
              name="multiplier"
              step="0.1"
              placeholder="1.0"
              class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-pink-50"
              required
            />
          </div>
          <div class="md:col-span-1">
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-pink-500 to-purple-500 text-white font-bold py-3 px-6 rounded-xl hover:from-pink-600 hover:to-purple-600 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
            >
              Add Activity
            </button>
          </div>
        </form>
      </div>

      <%!-- Activities List --%>
      <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-purple-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">🎯 Your Activities</h2>

        <%= if @activities == nil do %>
          <div class="space-y-4 animate-pulse">
            <div class="h-24 rounded-xl bg-purple-50 border border-purple-200"></div>
            <div class="h-24 rounded-xl bg-purple-50 border border-purple-200"></div>
          </div>
        <% end %>
        <%= if @activities == [] do %>
          <div class="text-center py-12 text-gray-500">
            <div class="text-6xl mb-4">🌟</div>
            <p class="text-lg">No activities yet!</p>
            <p class="text-sm mt-2">Activities will earn you play minutes based on time spent.</p>
          </div>
        <% end %>
        <%= if @activities not in [nil, []] do %>
          <div class="space-y-4">
            <%= for activity <- @activities do %>
              <%= if @editing_activity_id == activity.id do %>
                <form
                  phx-submit="save_activity"
                  class="p-4 rounded-xl bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-200"
                >
                  <input type="hidden" name="activity_id" value={activity.id} />
                  <div class="grid md:grid-cols-4 gap-4 items-end">
                    <div class="md:col-span-1">
                      <label class="block text-sm font-semibold text-gray-700 mb-2">Name</label>
                      <input
                        type="text"
                        name="name"
                        value={activity.name}
                        class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 bg-pink-50"
                        required
                      />
                    </div>
                    <div class="md:col-span-1">
                      <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Timing Project
                      </label>
                      <input
                        type="text"
                        name="time_source_identifier"
                        value={activity.time_source_identifier}
                        class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 bg-pink-50"
                        required
                      />
                    </div>
                    <div class="md:col-span-1">
                      <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Multiplier
                      </label>
                      <div class="flex items-center gap-2">
                        <button
                          type="button"
                          phx-click="decrement_multiplier"
                          class="px-3 py-3 rounded-xl border-2 border-pink-300 text-pink-700 font-bold hover:bg-pink-100"
                        >
                          −
                        </button>
                        <input
                          type="text"
                          name="multiplier"
                          value={@editing_multiplier}
                          readonly
                          class="w-full px-4 py-3 rounded-xl border-2 border-pink-300 text-gray-900 bg-pink-50 text-center"
                        />
                        <button
                          type="button"
                          phx-click="increment_multiplier"
                          class="px-3 py-3 rounded-xl border-2 border-pink-300 text-pink-700 font-bold hover:bg-pink-100"
                        >
                          +
                        </button>
                      </div>
                    </div>
                  </div>
                  <div class="flex justify-end gap-2 mt-4">
                    <button
                      type="button"
                      phx-click="cancel_edit_activity"
                      class="px-4 py-2 bg-white border-2 border-gray-300 text-gray-700 rounded-lg font-bold text-sm hover:bg-gray-50"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="px-4 py-2 bg-purple-600 text-white rounded-lg font-bold text-sm hover:bg-purple-700"
                    >
                      Save
                    </button>
                  </div>
                </form>
              <% else %>
                <div class="flex items-center gap-4 p-4 rounded-xl bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-200">
                  <div class="flex-1">
                    <div class="font-bold text-gray-900 text-lg">{activity.name}</div>
                    <div class="text-sm text-gray-600">
                      Multiplier:
                      <span class="font-semibold text-purple-600">{activity.multiplier}×</span>
                      · Source:
                      <span class="font-mono text-xs text-gray-500">
                        {activity.time_source_identifier}
                      </span>
                    </div>
                    <div class="text-sm text-gray-600 mt-1">
                      Today: <.time_display
                        minutes={activity.minutes}
                        format={:short}
                        value_class="font-semibold text-gray-900"
                      />
                      · play <.time_display
                        minutes={activity.play_minutes}
                        format={:short}
                        value_class="font-semibold text-purple-600"
                      />
                    </div>
                    <div class="text-sm text-gray-600 mt-1">
                      This week: <.time_display
                        minutes={activity.week_minutes}
                        format={:short}
                        value_class="font-semibold text-gray-900"
                      />
                      · play <.time_display
                        minutes={activity.week_play_minutes}
                        format={:short}
                        value_class="font-semibold text-purple-600"
                      />
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      phx-click="edit_activity"
                      phx-value-id={activity.id}
                      class="px-4 py-2 bg-white border-2 border-purple-300 text-purple-700 rounded-lg font-bold text-sm hover:bg-purple-50"
                    >
                      Edit
                    </button>
                    <div class="px-4 py-2 bg-purple-600 text-white rounded-lg font-bold text-sm">
                      Active
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
