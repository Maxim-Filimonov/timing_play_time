<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-orange-50 px-4 py-8">
    <div class="mx-auto max-w-2xl space-y-8">
      <div>
        <a href={~p"/"} class="text-purple-700 hover:text-purple-900 text-sm font-semibold">
          ← Back to dashboard
        </a>
        <h1 class="text-3xl font-bold text-gray-900 mt-2">Settings</h1>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-purple-200">
        <h2 class="text-xl font-bold text-gray-900 mb-4">🌍 Timezone</h2>
        <p class="text-gray-600 mb-4 text-sm">
          Used to compute "today" for each Activity's daily minutes. Auto-detected from your
          browser on first visit.
        </p>

        <form phx-submit="save_timezone" class="flex gap-3">
          <input
            type="text"
            name="timezone"
            value={@current_user.timezone}
            placeholder="Pacific/Auckland"
            class="flex-1 px-4 py-3 rounded-xl border-2 border-purple-300 focus:border-purple-500 focus:ring focus:ring-purple-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-purple-50"
            required
          />
          <button
            type="submit"
            class="bg-gradient-to-r from-purple-500 to-indigo-500 text-white font-bold py-3 px-6 rounded-xl hover:from-purple-600 hover:to-indigo-600 transition-all duration-200 shadow-lg hover:shadow-xl"
          >
            Save
          </button>
        </form>
      </div>

      <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-pink-200">
        <h2 class="text-xl font-bold text-gray-900 mb-4">🔌 Timing Integration</h2>
        <p class="text-gray-600 mb-4 text-sm">
          <%= if @integration do %>
            Connected. Paste a new key below to replace it.
          <% else %>
            Not connected yet — paste a personal API key from Timing's web app (API Keys section).
          <% end %>
        </p>

        <form phx-submit="save_integration" class="flex gap-3">
          <input
            type="password"
            name="api_key"
            placeholder="Timing API key"
            class="flex-1 px-4 py-3 rounded-xl border-2 border-pink-300 focus:border-pink-500 focus:ring focus:ring-pink-200 focus:ring-opacity-50 text-gray-900 placeholder-gray-400 bg-pink-50"
            required
          />
          <button
            type="submit"
            class="bg-gradient-to-r from-pink-500 to-purple-500 text-white font-bold py-3 px-6 rounded-xl hover:from-pink-600 hover:to-purple-600 transition-all duration-200 shadow-lg hover:shadow-xl"
          >
            Save
          </button>
        </form>
      </div>

      <p class="text-center text-xs text-gray-400">Account ID: {@current_user.id}</p>
    </div>
  </div>
</Layouts.app>
